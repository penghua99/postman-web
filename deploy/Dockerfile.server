# ============================================================
# Postman 网页版（多用户版）- 后端镜像（3 容器模式的 server 端）
#
# 注意：推荐使用单容器方案 deploy/Dockerfile.all（postgres+node+nginx）。
# 本文件保留用于 3 容器传统部署，源码已为多用户 standalone 版，
# 直接构建即可，无需任何构建期覆盖。
# ============================================================

# ========== 构建阶段 ==========
FROM node:22-alpine AS builder

WORKDIR /app

# 安装依赖
COPY package*.json ./
RUN npm config set fetch-retries 5 --location=global && npm ci --production=false --ignore-scripts --maxsockets 4

# 复制源码
COPY . .

# 构建后端（standalone 多用户版，含 auth / admin 模块）
RUN npx nest build --config nest-cli.standalone.json

# ========== 运行阶段 ==========
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# 只复制生产依赖
COPY package*.json ./
RUN npm config set fetch-retries 5 --location=global && npm ci --production=true --ignore-scripts --maxsockets 4 && npm cache clean --force

# 复制构建产物
COPY --from=builder /app/dist ./dist

ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=3000

EXPOSE 3000

WORKDIR /app/dist/server
CMD ["node", "main.standalone.js"]
