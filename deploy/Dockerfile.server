EOF

RUN cat > server/modules/history/history.controller.ts << 'EOF'
import {
  Controller,
  Get,
  Delete,
  Param,
  Query,
} from '@nestjs/common';
import { HistoryService } from './history.service';
import type {
  HistoryItem,
  ListHistoryResponse,
} from '@shared/api.interface';

const LOCAL_USER_ID = 'local_user';

@Controller('api/history')
export class HistoryController {
  constructor(private readonly historyService: HistoryService) {}

  @Get()
  async findAll(
    @Query('limit') limit?: string,
  ): Promise<ListHistoryResponse> {
    const limitNum = limit ? parseInt(limit, 10) : 50;
    return this.historyService.list(LOCAL_USER_ID, limitNum);
  }

  @Get(':id')
  async findOne(@Param('id') id: string): Promise<HistoryItem> {
    return this.historyService.get(id, LOCAL_USER_ID);
  }

  @Delete(':id')
  async remove(@Param('id') id: string): Promise<void> {
    await this.historyService.remove(id, LOCAL_USER_ID);
  }

  @Delete()
  async clear(): Promise<void> {
    await this.historyService.clear(LOCAL_USER_ID);
  }
}
EOF

RUN cat > server/modules/proxy/proxy.controller.ts << 'EOF'
import { Controller, Post, Body } from '@nestjs/common';
import { ProxyService } from './proxy.service';
import { HistoryService } from '../history/history.service';
import type {
  ProxyRequestDto,
  ProxyResponse,
} from '@shared/api.interface';

const LOCAL_USER_ID = 'local_user';

@Controller('api/proxy')
export class ProxyController {
  constructor(
    private readonly proxyService: ProxyService,
    private readonly historyService: HistoryService,
  ) {}

  @Post('send')
  async send(@Body() dto: ProxyRequestDto): Promise<ProxyResponse> {
    const result = await this.proxyService.sendRequest(dto);
    await this.historyService.create(
      {
        method: dto.method,
        url: dto.url,
        statusCode: result.status,
        responseTime: result.responseTime,
        responseSize: result.responseSize,
        requestData: {
          method: dto.method,
          url: dto.url,
          params: dto.params,
          headers: dto.headers,
          body: dto.body,
          authType: dto.authType,
          auth: dto.auth,
        },
        responsePreview:
          result.data.length > 2000
            ? result.data.slice(0, 2000) + '...'
            : result.data,
        userId: LOCAL_USER_ID,
      }
    );
    return result;
  }
}
EOF

# 构建后端（使用独立部署配置）
RUN npx nest build --config nest-cli.standalone.json

# ========== 运行阶段 ==========
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# 只复制生产依赖
COPY package*.json ./
RUN npm config set fetch-retries 5 --location=global && npm ci --production=true --ignore-scripts --maxsockets 4 && npm cache clean --force

# 复制构建产物
COPY --from=builder /app/dist ./dist

ENV SERVER_HOST=0.0.0.0
ENV SERVER_PORT=3000

EXPOSE 3000

WORKDIR /app/dist/server
CMD ["node", "main.standalone.js"]
