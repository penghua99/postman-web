# ========== 构建阶段 ==========
FROM node:22-alpine AS builder

WORKDIR /app

# 安装依赖
COPY package*.json ./
RUN npm config set fetch-retries 5 --location=global && npm ci --production=false --ignore-scripts --maxsockets 4

# 复制源码
COPY . .

# ── 平台无关化改造：替换 Controller（去掉 @NeedLogin，固定 local_user） ──

RUN cat > server/modules/collections/collections.controller.ts << 'EOF'
import {
  Controller,
  Get,
  Post,
  Patch,
  Delete,
  Body,
  Param,
} from '@nestjs/common';
import { CollectionsService } from './collections.service';
import type {
  CollectionTreeItem,
  CreateCollectionDto,
  UpdateCollectionDto,
  ExportCollectionResponse,
  ImportCollectionDto,
} from '@shared/api.interface';

const LOCAL_USER_ID = 'local_user';

@Controller('api/collections')
export class CollectionsController {
  constructor(private readonly collectionsService: CollectionsService) {}

  @Get('tree')
  async getTree(): Promise<CollectionTreeItem[]> {
    return this.collectionsService.getTree(LOCAL_USER_ID);
  }

  @Post()
  async create(@Body() dto: CreateCollectionDto): Promise<CollectionTreeItem> {
    return this.collectionsService.create(dto, LOCAL_USER_ID);
  }

  @Patch(':id')
  async update(
    @Param('id') id: string,
    @Body() dto: UpdateCollectionDto,
  ): Promise<CollectionTreeItem> {
    return this.collectionsService.update(id, dto, LOCAL_USER_ID);
  }

  @Delete(':id')
  async remove(@Param('id') id: string): Promise<void> {
    await this.collectionsService.remove(id, LOCAL_USER_ID);
  }

  @Get(':id/export')
  async exportCollection(
    @Param('id') id: string,
  ): Promise<ExportCollectionResponse> {
    return this.collectionsService.exportCollection(id, LOCAL_USER_ID);
  }

  @Post('import')
  async importCollection(
    @Body() dto: ImportCollectionDto,
  ): Promise<CollectionTreeItem> {
    return this.collectionsService.importCollection(dto, LOCAL_USER_ID);
  }
}
EOF

RUN cat > server/modules/collections/requests.controller.ts << 'EOF'
import {
  Controller,
  Get,
  Post,
  Patch,
  Delete,
  Body,
  Param,
  Query,
} from '@nestjs/common';
import { CollectionsService } from './collections.service';
import type {
  RequestItem,
  CreateRequestDto,
  UpdateRequestDto,
} from '@shared/api.interface';

const LOCAL_USER_ID = 'local_user';

@Controller('api/requests')
export class RequestsController {
  constructor(private readonly collectionsService: CollectionsService) {}

  @Get()
  async listRequests(
    @Query('collectionId') collectionId: string,
  ): Promise<RequestItem[]> {
    return this.collectionsService.listRequests(collectionId, LOCAL_USER_ID);
  }

  @Get(':id')
  async getRequest(@Param('id') id: string): Promise<RequestItem> {
    return this.collectionsService.getRequest(id, LOCAL_USER_ID);
  }

  @Post()
  async createRequest(
    @Body() dto: CreateRequestDto,
  ): Promise<RequestItem> {
    return this.collectionsService.createRequest(dto, LOCAL_USER_ID);
  }

  @Patch(':id')
  async updateRequest(
    @Param('id') id: string,
    @Body() dto: UpdateRequestDto,
  ): Promise<RequestItem> {
    return this.collectionsService.updateRequest(id, dto, LOCAL_USER_ID);
  }

  @Delete(':id')
  async deleteRequest(@Param('id') id: string): Promise<void> {
    await this.collectionsService.deleteRequest(id, LOCAL_USER_ID);
  }
}
EOF

RUN cat > server/modules/environments/environments.controller.ts << 'EOF'
import {
