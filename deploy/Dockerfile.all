# ============================================================
# Postman 网页版（多用户版）- 单容器镜像
#
# 一个容器内同时运行：PostgreSQL + NestJS 后端 + Nginx 前端
# 对外仅暴露一个端口（80），数据库仅监听 127.0.0.1
#
# 构建：
#   docker build -f deploy/Dockerfile.all -t postman:latest .
# 运行（推荐使用 deploy/docker-compose.all.yml）
# ============================================================

# ---------- 构建阶段 ----------
FROM node:22-alpine AS builder

WORKDIR /app

# 安装依赖（与 package-lock.json 同源，使用官方 registry）
COPY package*.json ./
RUN npm config set fetch-retries 5 --location=global && npm config set registry https://registry.npmjs.org && npm ci --production=false --ignore-scripts --maxsockets 4

# 复制源码
COPY . .

# 前端入口切换为 standalone 版本
RUN cp client/index.standalone.html client/index.html

# 构建后端（standalone 多用户版，含 auth / admin 模块）
RUN npx nest build --config nest-cli.standalone.json

# 构建前端（standalone 多用户版）
RUN npx vite build --config vite.config.standalone.ts --mode production

# ---------- 运行阶段（单容器） ----------
FROM postgres:16-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# 安装 Node.js / npm / Nginx / Bash（使用阿里云 Alpine 镜像源，规避 dl-cdn 下载挂起）
# 注：postgres:16-alpine 基于 Alpine，nodejs 包版本为 v24.x
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories && apk add --no-cache nodejs npm nginx bash && rm -rf /var/cache/apk/*

# 安装后端生产依赖（npm install 容忍 lock 中可选平台节点不完整，自动补全）
COPY package*.json ./
RUN npm config set fetch-retries 5 --location=global && npm config set registry https://registry.npmjs.org && npm install --omit=dev --ignore-scripts --no-audit --no-fund --maxsockets 4 && npm cache clean --force

# 复制后端构建产物
COPY --from=builder /app/dist ./dist

# 复制前端静态资源
COPY --from=builder /app/dist/client /usr/share/nginx/html

# Nginx 配置（反代 /api -> 127.0.0.1:3000）
# 注意：Alpine nginx 在根上下文 include conf.d/*.conf（server 块会报 emerg），
#       http.d/ 才是 http 上下文，server 块必须放这里。
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/http.d/default.conf

# 数据库初始化脚本（首次启动自动执行，含建表与种子数据）
COPY deploy/init.all.sql /docker-entrypoint-initdb.d/init.sql

# 单容器启动脚本（依次启动 postgres -> node -> nginx）
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint.all.sh
RUN chmod +x /usr/local/bin/entrypoint.all.sh

ENV SERVER_HOST=127.0.0.1
ENV SERVER_PORT=3000

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/entrypoint.all.sh"]
