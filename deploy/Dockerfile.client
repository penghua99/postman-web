# ============================================================
# Postman 网页版（多用户版）- 前端镜像（3 容器模式的 client 端）
#
# 注意：推荐使用单容器方案 deploy/Dockerfile.all（postgres+node+nginx）。
# 本文件保留用于 3 容器传统部署，源码已为多用户 standalone 版，
# 直接构建即可，无需任何构建期覆盖。
# ============================================================

# ========== 构建阶段 ==========
FROM node:22-alpine AS builder

WORKDIR /app

# 安装依赖
COPY package*.json ./
RUN npm config set fetch-retries 5 --location=global && npm ci --production=false --ignore-scripts --maxsockets 4

# 复制源码
COPY . .

# 前端入口切换为 standalone 版本
RUN cp client/index.standalone.html client/index.html

# 构建前端（standalone 多用户版）
RUN npx vite build --config vite.config.standalone.ts --mode production

# ========== 运行阶段 ==========
FROM nginx:alpine AS runner

# 复制构建产物
COPY --from=builder /app/dist/client /usr/share/nginx/html

# 复制 nginx 配置（反代 /api -> 127.0.0.1:3000，3 容器模式请改回 server:3000）
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
